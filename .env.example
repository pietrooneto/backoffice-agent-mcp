# Provider LLM: "ollama" (API nativa di Ollama) oppure "openai_compat"
# (qualunque server con API compatibile OpenAI, anche locale, es. Ollama su /v1).
# Il provider openai_compat e' coperto dai test con un server finto; dal vivo e' stato provato solo Ollama.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Nome del modello (vuoto = qwen2.5:7b)
OLLAMA_MODEL=
# Solo per openai_compat
OPENAI_BASE_URL=http://localhost:11434/v1
# Chiave API, se il server la richiede (NON committare il file .env reale; non viene mai scritta nei log)
LLM_API_KEY=
# Harness
MAX_ITERATIONS=10
TIMEOUT_MODELLO=600
TIMEOUT_TOOL=60
NUM_CTX=8192
# Variante del prompt di sistema: "base" (versione di partenza) oppure "v2" (con una regola per ogni
# difetto osservato nel primo giro di scenari). Vuoto = base.
VARIANTE_PROMPT=
# Controlli dell'harness sulle scritture (id non inventati, anteprima dell'azione). Attivi di default:
# "0", "no" o "false" li disattivano (serve solo per confrontare i risultati con e senza). Vuoto = attivi.
CONTROLLI_HARNESS=
# Interfaccia web: porta su 127.0.0.1. Vuoto = 8000.
WEB_PORT=
DB_PATH=backend/ticketing.db
LOG_DIR=logs
# Server MCP: "ora attuale" dei tool. Vuoto = data fissa del seed (scenari ripetibili),
# "reale" = ora di sistema, oppure una data "AAAA-MM-GG HH:MM:SS".
RIFERIMENTO_ORA=
# Server MCP: tool che devono fallire come un guasto del database (separati da virgola).
# Serve solo per gli scenari di errore, es. SIMULA_GUASTO=dettaglio_evento
SIMULA_GUASTO=
