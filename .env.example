# Provider LLM: "ollama" (API nativa di Ollama) oppure "openai_compat"
# (qualunque server con API compatibile OpenAI, anche locale, es. Ollama su /v1)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Nome del modello (vuoto = qwen2.5:7b)
OLLAMA_MODEL=
# Solo per openai_compat
OPENAI_BASE_URL=http://localhost:11434/v1
# Chiave API, se il server la richiede (NON committare il file .env reale)
LLM_API_KEY=
# Harness
MAX_ITERATIONS=10
TIMEOUT_MODELLO=600
TIMEOUT_TOOL=60
NUM_CTX=8192
DB_PATH=backend/ticketing.db
LOG_DIR=logs
# Server MCP: "ora attuale" dei tool. Vuoto = data fissa del seed (scenari ripetibili),
# "reale" = ora di sistema, oppure una data "AAAA-MM-GG HH:MM:SS".
RIFERIMENTO_ORA=
# Server MCP: tool che devono fallire come un guasto del database (separati da virgola).
# Serve solo per gli scenari di errore, es. SIMULA_GUASTO=dettaglio_evento
SIMULA_GUASTO=
